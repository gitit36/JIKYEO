# Ordinary production / TestFlight API. Copy outside the repo; never commit secrets.
# Review/demo MONEY is a separate configuration (`REVIEW_DEMO_MONEY=true`) and
# must not be used for normal TestFlight.

NODE_ENV=production
PORT=3001
LOG_LEVEL=info

DATABASE_URL=
REDIS_URL=

JWT_SECRET=
QUOTE_SIGNING_SECRET=
INTERNAL_JOB_SECRET=
ADMIN_API_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

S3_ENDPOINT=
S3_REGION=ap-northeast-2
S3_BUCKET_EVIDENCE=evidence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

PAYMENT_PROVIDER=mock
# Fail-closed until the Real KCP production phase and launch gates pass.
MONEY_ENABLED=false
# Do not set REVIEW_DEMO_MONEY for ordinary TestFlight/production.
VERIFICATION_PROVIDER=mock
PUSH_PROVIDER=apns
# Configure APNs outside the repo. Never commit a .p8.
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY=
# APNS_TOPIC=com.jikyeo.app

MAX_STAKE_PER_OCCURRENCE_KRW=100000
MAX_LOSS_PER_COMMITMENT_KRW=500000
DEFAULT_EVIDENCE_RETENTION_DAYS=30
NETWORK_GRACE_SECONDS=180
SIGNATURE_EXPIRY_SECONDS=1800
ACTIVE_CANCELLATION_NOTICE_SECONDS=86400
APPEAL_WINDOW_SECONDS=604800
RECAP_LOCAL_HOUR=9
PUSH_TOKEN_ENCRYPTION_SECRET=
