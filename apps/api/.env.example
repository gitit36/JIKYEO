NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgresql://jikyeo:jikyeo@localhost:5432/jikyeo?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=dev-only-change-me
QUOTE_SIGNING_SECRET=dev-only-quote-signing-secret
INTERNAL_JOB_SECRET=dev-only-internal-job-secret
ADMIN_API_SECRET=dev-only-admin-api-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

S3_ENDPOINT=http://localhost:4566
S3_REGION=ap-northeast-2
S3_BUCKET_EVIDENCE=evidence
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test

# Provider selection — MVP defaults to mocks
PAYMENT_PROVIDER=mock
VERIFICATION_PROVIDER=mock
PUSH_PROVIDER=mock

# Business rules
MAX_STAKE_PER_OCCURRENCE_KRW=100000
MAX_LOSS_PER_COMMITMENT_KRW=500000
DEFAULT_EVIDENCE_RETENTION_DAYS=30
NETWORK_GRACE_SECONDS=180
SIGNATURE_EXPIRY_SECONDS=1800
APPEAL_WINDOW_SECONDS=604800
